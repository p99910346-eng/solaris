local function MakeDraggable(frame, titleBar)
    local isDragging = false
    local dragStart = nil
    local frameStart = nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            dragStart = input.Position
            frameStart = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement and dragStart and frameStart then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
    end)
end

-- Функция получения количества предмета (из стеков)
local function getItemStackCount(toolObject)
    if not toolObject then return 0 end
    
    for _, child in ipairs(toolObject:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then
            local cName = string.lower(child.Name)
            if string.find(cName, "amount") or string.find(cName, "count") or string.find(cName, "value") or string.find(cName, "stack") then
                return tonumber(child.Value) or 1
            end
        end
    end
    
    local attributes = toolObject:GetAttributes()
    for attrName, attrValue in pairs(attributes) do
        local aName = string.lower(attrName)
        if (string.find(aName, "amount") or string.find(aName, "count") or string.find(aName, "value") or string.find(aName, "stack")) and typeof(attrValue) == "number" then
            return attrValue
        end
    end
    
    return 1
end

-- Функция получения общего количества предмета
local function getTotalItemCount(itemName)
    local totalCount = 0
    
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item.Name == itemName then
                totalCount = totalCount + getItemStackCount(item)
            end
        end
    end
    
    if LocalPlayer.Character then
        for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
            if item.Name == itemName then
                totalCount = totalCount + getItemStackCount(item)
            end
        end
    end
    
    return totalCount
end

-- Функция для создания переключателя
local function createToggle(frame, yPos, name, callback)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(0.9, 0, 0, 35)
    toggleFrame.Position = UDim2.new(0.05, 0, 0, yPos)
    toggleFrame.BackgroundColor3 = Colors.Button
    toggleFrame.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Colors.Text
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    label.Parent = toggleFrame
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.3, 0, 0.7, 0)
    toggleBtn.Position = UDim2.new(0.68, 0, 0.15, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 150)
    toggleBtn.Text = "ВЫКЛ"
    toggleBtn.TextColor3 = Colors.Text
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 9
    toggleBtn.Parent = toggleFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn
    
    local enabled = false
    
    toggleBtn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            toggleBtn.Text = "ВКЛ"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 255, 150)
        else
            toggleBtn.Text = "ВЫКЛ"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 150)
        end
        callback(enabled)
    end)
    
    return toggleFrame
end

