local HIGHLIGHT_COLOR = Color3.fromRGB(255, 60, 60)
local FILL_TRANSPARENCY = 0.7
local OUTLINE_TRANSPARENCY = 0
local ARROW_COLOR = Color3.fromRGB(255, 60, 60)
local ARROW_SIZE = 60
local ARROW_OFFSET = 120

