local function MakeDraggable(frame, titleBar)
    local isDragging = false
    local dragStart = nil
    local frameStart = nil
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            dragStart = input.Position
            frameStart = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement and dragStart and frameStart then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
    end)
end

-- Функция получения количества предмета
local function getItemStackCount(toolObject)
    if not toolObject then return 0 end
    for _, child in ipairs(toolObject:GetChildren()) do
        if child:IsA("IntValue") or child:IsA("NumberValue") then
            local cName = string.lower(child.Name)
            if string.find(cName, "amount") or string.find(cName, "count") or string.find(cName, "value") or string.find(cName, "stack") then
                return tonumber(child.Value) or 1
            end
        end
    end
    local attributes = toolObject:GetAttributes()
    for attrName, attrValue in pairs(attributes) do
        local aName = string.lower(attrName)
        if (string.find(aName, "amount") or string.find(aName, "count") or string.find(aName, "value") or string.find(aName, "stack")) and typeof(attrValue) == "number" then
            return attrValue
        end
    end
    return 1
end

local function getTotalItemCount(itemName)
    local totalCount = 0
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item.Name == itemName then
                totalCount = totalCount + getItemStackCount(item)
            end
        end
    end
    if LocalPlayer.Character then
        for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
            if item.Name == itemName then
                totalCount = totalCount + getItemStackCount(item)
            end
        end
    end
    return totalCount
end

local function simulateKeyPressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.15)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function preciseMouseClick(x, y)
    VirtualInputManager:SendMouseMoveEvent(x, y, game)
    task.wait(0.15)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.08)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function dragMouseDown(startX, startY, endX, endY)
    VirtualInputManager:SendMouseMoveEvent(startX, startY, game)
    task.wait(0.15)
    VirtualInputManager:SendMouseButtonEvent(startX, startY, 0, true, game, 1)
    task.wait(0.1)
    local steps = 15
    for i = 1, steps do
        local currentX = startX + (endX - startX) * (i / steps)
        local currentY = startY + (endY - startY) * (i / steps)
        VirtualInputManager:SendMouseMoveEvent(currentX, currentY, game)
        task.wait(0.02)
    end
    task.wait(0.15)
    VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1)
    task.wait(0.2)
end

local function scrollAt(x, y, direction)
    VirtualInputManager:SendMouseMoveEvent(x, y, game)
    task.wait(0.1)
    VirtualInputManager:SendMouseWheelEvent(x, y, direction, game)
    task.wait(0.1)
end

