                    InfoLabel.Text = "Статус: Запуск..."
                    rootPart.CFrame = targetCFrame
                    task.wait(0.5)
                    pressE()
                    task.wait(0.5)
                    clickMouse(1420, 533)
                    task.wait(1.0)
                    rootPart.CFrame = savedPos * CFrame.new(0, 4, 0)
                    firstRun = false
                end
                for i = cookingTime, 1, -1 do
                    if not isFarming then break end
                    ToggleBtn.Text = "Печётся: " .. i .. "с"
                    InfoLabel.Text = "Выпекание " .. i .. "/" .. cookingTime
                    task.wait(1)
                end
                if isFarming and not firstRun then
                    local loopSavedPos = straightLook(rootPart.CFrame)
                    rootPart.CFrame = targetCFrame
                    task.wait(0.5)
                    pressE()
                    task.wait(0.6)
                    pressE()
                    task.wait(0.5)
                    clickMouse(1420, 533)
                    task.wait(1.0)
                    rootPart.CFrame = loopSavedPos * CFrame.new(0, 4, 0)
                    task.wait(0.5)
                end
            end
        end
    end)
    ToggleBtn.MouseButton1Click:Connect(function()
        isFarming = not isFarming
        if isFarming then
            ToggleBtn.Text = "Авто-готовка: ВКЛ"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 255, 150)
        else
            firstRun = true
            ToggleBtn.Text = "Авто-готовка: ВЫКЛ"
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 150)
            InfoLabel.Text = "Статус: Отключено"
        end
    end)
end

