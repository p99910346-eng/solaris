-- СТРЕЛКА
-- ═══════════════════════════════════════════
local function createArrowGui()
    local gui = Instance.new("ScreenGui")
    gui.Name = "DropArrowGui"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui
    gui.Enabled = false
    
    local frame = Instance.new("Frame")
    frame.Name = "ArrowFrame"
    frame.Size = UDim2.new(0, ARROW_SIZE, 0, ARROW_SIZE)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = gui
    
    local arrow = Instance.new("TextLabel")
    arrow.Name = "Arrow"
    arrow.Size = UDim2.new(1, 0, 1, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text = "▲"
    arrow.TextColor3 = ARROW_COLOR
    arrow.TextStrokeColor3 = Color3.fromRGB(255, 255, 255)
    arrow.TextStrokeTransparency = 0
    arrow.Font = Enum.Font.GothamBold
    arrow.TextSize = ARROW_SIZE
    arrow.Parent = frame
    
    local pulseTween = TweenService:Create(arrow, 
        TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {TextTransparency = 0.4}
    )
    pulseTween:Play()
    
    return gui, frame
end

local function updateArrow()
    if not arrowOn or not arrowGui then return end
    
    local dropPos = getDropPosition()
    if not dropPos then
        arrowGui.Enabled = false
        return
    end
    arrowGui.Enabled = true
    
    local camPos = camera.CFrame.Position
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    local screenPoint, onScreen = camera:WorldToViewportPoint(dropPos)
    local isBehind = screenPoint.Z < 0
    
    local targetX, targetY
    
    if onScreen and not isBehind then
        targetX = screenPoint.X
        targetY = screenPoint.Y
    else
        local direction = (dropPos - camPos).Unit
        local camRight = camera.CFrame.RightVector
        local camUp = camera.CFrame.UpVector
        
        local right = direction:Dot(camRight)
        local up = direction:Dot(camUp)
        
        if isBehind then
            right = -right
            up = -up
        end
        
        local angle = math.atan2(up, right)
        local radius = math.min(camera.ViewportSize.X, camera.ViewportSize.Y) / 2 - ARROW_OFFSET + 60
        
        targetX = screenCenter.X + math.cos(angle) * radius
        targetY = screenCenter.Y - math.sin(angle) * radius
    end
    
    local arrowFrame = arrowGui:FindFirstChild("ArrowFrame")
    if arrowFrame then
        arrowFrame.Position = UDim2.new(0, targetX, 0, targetY)
        local dx = targetX - screenCenter.X
        local dy = targetY - screenCenter.Y
        local rotation = math.deg(math.atan2(dy, dx)) + 90
        arrowFrame.Rotation = rotation
    end
end

