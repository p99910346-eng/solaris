-- ОБНОВЛЕНИЕ
-- ═══════════════════════════════════════════
local lastStatus = nil

RunService.RenderStepped:Connect(function()
    if highlightOn then
        local current = findDrop()
        if current and current ~= targetDrop then
            enableHighlight()
        elseif not current and highlight then
            highlight:Destroy()
            highlight = nil
            targetDrop = nil
        end
    end
    
    if arrowOn then
        updateArrow()
    end
    
    local now = tick()
    if not lastStatus or now - lastStatus > 1 then
        lastStatus = now
        updateStatus()
    end
    
    local drop = findDrop()
    if drop and not wasDropPresent then
        if now - lastNotify > 4 then
            lastNotify = now
            task.spawn(showNotification)
        end
        wasDropPresent = true
    elseif not drop then
        wasDropPresent = false
    end
end)

updateStatus()

