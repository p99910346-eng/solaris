            StatusLabel.Text = "Статус: Ожидание"
            StatusLabel.TextColor3 = Color3.fromRGB(100, 100, 120)
        end
    end)
    
    local function executeMovementToTarget(targetPart, consoleName)
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") and targetPart then
            isPaused = true
            isFarming = false
            
            character:PivotTo(targetPart.CFrame * CFrame.new(0, 0, -2))
            lastTeleportTime = os.time()
            
            StatusLabel.Text = "Прибыл к " .. consoleName
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
            
            task.wait(0.5)
            simulateKeyPressE()
            
            StatusLabel.Text = "Пауза 3 секунды..."
            task.wait(3)
            
            isPaused = false
            if ToggleBtn.Text == "Цикл: ВКЛ" then
                isFarming = true
            end
            
            task.spawn(function()
                for i = teleportCooldown, 1, -1 do
                    task.wait(1)
                    if not isSystemActive then break end
                    StatusLabel.Text = "Кулдаун: " .. tostring(i) .. "с"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
                end
                if isSystemActive then
                    StatusLabel.Text = "Мониторинг консолей..."
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                end
            end)
        end
    end
    
    local function processDualConsoleScanner()
        if not isSystemActive then return end
        if isPaused then return end
        if os.time() - lastTeleportTime < teleportCooldown then return end
        
        local success, factoryFolder = pcall(function()
            return Workspace.Map.ScriptObjects.Factory.FactoryConveyor.Console
        end)
        
        if not success or not factoryFolder then return end
        
        local c1 = factoryFolder:FindFirstChild("Console1")
        local p1 = c1 and c1:FindFirstChild("RepairPrompt")
        if p1 and p1:IsA("ProximityPrompt") and p1.Enabled == true then
            local part = p1.Parent
            if part and part:IsA("BasePart") then
                executeMovementToTarget(part, "Console1")
                return
            end
        end
        
        local c2 = factoryFolder:FindFirstChild("Console2")
        local p2 = c2 and c2:FindFirstChild("RepairPrompt")
        if p2 and p2:IsA("ProximityPrompt") and p2.Enabled == true then
            local part = p2.Parent
            if part and part:IsA("BasePart") then
                executeMovementToTarget(part, "Console2")
                return
            end
        end
    end
    
    task.spawn(function()
        while true do
            task.wait(0.1)
            if not SG or not SG.Parent then break end
            if isFarming and not isPaused then
                local char = getCharacter()
                local rootPart = char:WaitForChild("HumanoidRootPart")
                rootPart.CFrame = CFrame.lookAt(Point1, Point1 + Vector3.new(0, 0, -1))
                task.wait(farmSpeed)
                if isFarming and not isPaused then simulateKeyPressE() task.wait(farmSpeed) end
                rootPart.CFrame = CFrame.lookAt(Point2, Point2 + Vector3.new(0, 0, -1))
                task.wait(farmSpeed)
                if isFarming and not isPaused then simulateKeyPressE() task.wait(farmSpeed) end
            end
        end
    end)
    
    task.spawn(function()
        while true do
            task.wait(0.2)
            if not SG or not SG.Parent then break end
            pcall(processDualConsoleScanner)
        end
    end)
    
    task.spawn(function()
        while true do
            task.wait(1)
            if not SG or not SG.Parent then break end
            if isFarming and not isPaused then
                if os.time() - lastDPressTime >= 30 then
                    simulateKeyPressD()
                    lastDPressTime = os.time()
                end
            end
        end
    end)
end

