-- ГЕНЕРАЦИЯ СПИСКА КУБОВ (размеры 8..100 — 93 куба)
-- Цвета генерируются по HSL-спектру — оттенок плавно меняется
-- ═══════════════════════════════════════════
local CUBE_PRESETS = {}

-- Генерируем цвета через HSV (плавный переход по кругу)
local total = 100 - 8 + 1  -- 93 куба
for i = 1, total do
    local size = 7 + i  -- 8, 9, 10, ... 100
    local hue = (i - 1) / total  -- 0..1
    local color = Color3.fromHSV(hue, 0.9, 1)  -- насыщенный, яркий
    
    -- Индивидуальные названия для первых 35 (проверенные цвета)
    local names = {
        [8]  = "Голубой",   [9]  = "Оранжевый",  [10] = "Салатовый",
        [11] = "Фиолетовый",[12] = "Красный",    [13] = "Розовый",
        [14] = "Жёлтый",    [15] = "Бирюзовый",  [16] = "Лаймовый",
        [17] = "Индиго",    [18] = "Золотой",    [19] = "Малиновый",
        [20] = "Небесный",  [21] = "Мятный",     [22] = "Коралловый",
        [23] = "Лавандовый",[24] = "Белый",      [25] = "Чёрный",
        [26] = "Изумрудный",[27] = "Маджента",   [28] = "Аквамарин",
        [29] = "Янтарный",  [30] = "Синий",      [31] = "Персиковый",
        [32] = "Сиреневый", [33] = "Хаки",       [34] = "Ржавый",
        [35] = "Тёмно-серый",
    }
    
    -- Для 24 (Белый) и 25 (Чёрный) задаём цвета вручную
    if size == 24 then color = Color3.fromRGB(255, 255, 255) end
    if size == 25 then color = Color3.fromRGB(30, 30, 30) end
    
    local name = names[size] or ("Цвет " .. size)
    
    table.insert(CUBE_PRESETS, {
        Name = tostring(size) .. " · " .. name,
        Color = color,
        Size = size,
        Model = nil,
        Conn = nil,
    })
end

local WALL_THICKNESS = 1

local cubesActive = false
local selected = {}
for i = 1, #CUBE_PRESETS do
    selected[i] = false
end

-- ═══════════════════════════════════════════
-- ФИЛЬТР ПУЛЬ
-- ═══════════════════════════════════════════
local function isBullet(obj)
    if not obj then return false end
    local name = string.lower(obj.Name)
    local parentName = ""
    if obj.Parent then parentName = string.lower(obj.Parent.Name) end
    return string.find(name, "bullet") or string.find(name, "projectile") or
           string.find(name, "shot") or string.find(name, "ammo") or
           string.find(name, "arrow") or string.find(name, "grenade") or
           string.find(name, "missile") or string.find(name, "rocket") or
           string.find(name, "laser") or string.find(name, "beam") or
           string.find(name, "ray") or
           string.find(parentName, "bullet") or string.find(parentName, "projectile") or
           string.find(parentName, "shot") or string.find(parentName, "weapon") or
           string.find(parentName, "gun") or string.find(parentName, "ammo")
end

-- ═══════════════════════════════════════════
-- СОЗДАНИЕ КУБА
-- ═══════════════════════════════════════════
local function createCubeShell(size, thickness, color, name)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local root = char.HumanoidRootPart
    local half = size / 2
    
    local model = Instance.new("Model")
    model.Name = name or "CubeShell"
    model.Parent = workspace
    
    local walls = {
        {Size = Vector3.new(size, thickness, size), Offset = Vector3.new(0,  half, 0)},
        {Size = Vector3.new(size, thickness, size), Offset = Vector3.new(0, -half, 0)},
        {Size = Vector3.new(size, size, thickness), Offset = Vector3.new(0, 0,  half)},
        {Size = Vector3.new(size, size, thickness), Offset = Vector3.new(0, 0, -half)},
        {Size = Vector3.new(thickness, size, size), Offset = Vector3.new( half, 0, 0)},
        {Size = Vector3.new(thickness, size, size), Offset = Vector3.new(-half, 0, 0)},
    }
    
    for i, wallData in ipairs(walls) do
        local wall = Instance.new("Part")
        wall.Name = "Wall_" .. i
        wall.Shape = Enum.PartType.Block
        wall.Size = wallData.Size
        wall.Position = root.Position + wallData.Offset
        wall.Anchored = true
        wall.CanCollide = true
        wall.CanTouch = true
        wall.CanQuery = false
        wall.Material = Enum.Material.ForceField
        wall.Color = color
        wall.Transparency = 0.2
        wall.Parent = model
        
        wall.Touched:Connect(function(hit)
            if isBullet(hit) then
                hit:Destroy()
                if hit.Parent and hit.Parent ~= workspace and hit.Parent ~= char then
                    pcall(function() hit.Parent:Destroy() end)
                end
            end
        end)
    end
    
    return model
end

local function updateCubePosition(model, size)
    if not model then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local root = char.HumanoidRootPart
    local half = size / 2
    
    local offsets = {
        Vector3.new(0,  half, 0),
        Vector3.new(0, -half, 0),
        Vector3.new(0, 0,  half),
        Vector3.new(0, 0, -half),
        Vector3.new( half, 0, 0),
        Vector3.new(-half, 0, 0),
    }
    
    for i, wall in ipairs(model:GetChildren()) do
        if wall:IsA("BasePart") and offsets[i] then
            wall.Position = root.Position + offsets[i]
        end
    end
end

-- ═══════════════════════════════════════════
-- СПАВН / УДАЛЕНИЕ
-- ═══════════════════════════════════════════
local buttonList = {}

local function spawnCube(index)
    local preset = CUBE_PRESETS[index]
    if not preset then return end
    if preset.Model then return end
    
    preset.Model = createCubeShell(preset.Size, WALL_THICKNESS, preset.Color, "Cube_" .. index)
    if preset.Model then
        preset.Conn = RunService.Heartbeat:Connect(function()
            updateCubePosition(preset.Model, preset.Size)
        end)
    end
end

local function despawnCube(index)
    local preset = CUBE_PRESETS[index]
    if not preset then return end
    
    if preset.Model then
        preset.Model:Destroy()
        preset.Model = nil
    end
    if preset.Conn then
        preset.Conn:Disconnect()
        preset.Conn = nil
    end
end

local function refreshButton(index)
    local btn = buttonList[index]
    local preset = CUBE_PRESETS[index]
    if not btn or not preset then return end
    
    local mark = selected[index] and "  ✓" or ""
    btn.Text = preset.Name .. "  (размер " .. preset.Size .. ")" .. mark
    btn.BackgroundTransparency = selected[index] and 0 or 0.15
end

local function onCubeClicked(index)
    selected[index] = not selected[index]
    refreshButton(index)
    
    if cubesActive then
        if selected[index] then
            spawnCube(index)
        else
            despawnCube(index)
        end
    end
end

local function selectAll(state)
    for i = 1, #CUBE_PRESETS do
        selected[i] = state
        refreshButton(i)
        if cubesActive then
            if state then
                spawnCube(i)
            else
                despawnCube(i)
            end
        end
    end
    print(state and "✓ Все кубы выбраны" or "✗ Все кубы отменены")
end

